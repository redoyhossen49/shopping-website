# Frontend environment (Vite). Copy to .env.local if you need to override.
#
# In development the frontend calls the relative "/api" path and Vite proxies it
# to the backend, so no value is needed below.
#
# In production, set VITE_API_URL only when the API is served from a different
# origin than the site, and include the /api suffix, e.g.:
#   VITE_API_URL=https://api.example.com/api
# Leave it unset when the API is on the same origin (or behind a reverse proxy).
VITE_API_URL=

# Currency code shown in the storefront. Keep in sync with the backend CURRENCY.
VITE_CURRENCY=BDT

# Target used by the Vite dev/preview proxy (backend base URL).
# Defaults to http://localhost:5000 when unset.
VITE_API_PROXY_TARGET=http://localhost:5000
