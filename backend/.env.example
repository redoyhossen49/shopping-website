# Local development uses the discrete DB_* variables below. In production a
# full connection string (RENDER_DATABASE_URL or DATABASE_URL) takes precedence
# when present and enables TLS automatically, so the API and migrations always
# target the same database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopping_db
DB_USER=postgres
DB_PASSWORD=your_db_password

JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_EXPIRES_IN=1d
COOKIE_NAME=novashop_token

# Comma-separated list of browser origins allowed for CORS/CSRF checks.
# Development also accepts any localhost/127.0.0.1 port automatically, so the
# list below mainly matters for production (your real site domains).
CLIENT_ORIGIN=http://localhost:5173
CURRENCY=BDT
DEFAULT_LOW_STOCK_THRESHOLD=5
DEFAULT_SHIPPING_FEE=0
BCRYPT_ROUNDS=12
NODE_ENV=development

# URLs used for payment redirects (change to your public URLs in production)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Allows returns/cancellations for this many days after delivery
RETURN_WINDOW_DAYS=14

# ---------------------------------------------------------------------------
# Demo / sandbox mode
# Enable ONLY for the public portfolio demo (synthetic data). When true, rows
# created through the API are tagged is_demo, the admin "reset demo data"
# endpoint is enabled, and the storefront shows a demo banner.
# NEVER enable against a database that holds real customer data.
# ---------------------------------------------------------------------------
DEMO_MODE=false
# Demo admin credentials. These are intentionally public (documented in the
# README) because the demo store holds no real data. Change if you prefer.
DEMO_ADMIN_NAME=Demo Store Manager
DEMO_ADMIN_EMAIL=demo.admin@novashop.dev
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_CUSTOMER_PASSWORD=DemoCustomer123!

# ---------------------------------------------------------------------------
# SSLCOMMERZ merchant credentials (bKash / Nagad / cards).
# Leave blank to keep online payments disabled (Cash on Delivery still works).
# Sandbox credentials: https://developer.sslcommerz.com/registration/
# Production credentials are issued by SSLCOMMERZ after merchant approval.
# NEVER commit real values.
# ---------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
